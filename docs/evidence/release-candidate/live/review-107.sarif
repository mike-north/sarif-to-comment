        }
      ],
      "artifacts": [],
      "results": [
        {
          "message": {
            "text": "A general remark on the rc030 fixture."
          }
        },
        {
          "message": {
            "text": "End this line with LF, and join its words with a zero-width space."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/experiments/rc030/crlf.txt"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "docs/experiments/rc030/crlf.txt"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 1,
                        "startColumn": 1,
                        "endLine": 2,
                        "endColumn": 1
                      },
                      "insertedContent": {
                        "text": "Only line,​with LF.\n"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
