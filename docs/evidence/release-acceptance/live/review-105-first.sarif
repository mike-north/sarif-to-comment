{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Release acceptance reviewer",
          "version": "1.0.0"
        }
      },
      "columnKind": "utf16CodeUnits",
      "versionControlProvenance": [
        {
          "repositoryUri": "https://github.com/mike-north/doc-linter",
          "revisionId": "bd76c7b51f895276df4d0c6f0418f5a4d24072a8"
        }
      ],
      "results": [
        {
          "message": {
            "text": "Line 5 reads well as reviewed."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/experiments/u8-forcepush/sample.md"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
