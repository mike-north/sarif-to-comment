{
  "name": "sarif-to-comment",
  "version": "0.2.1",
  "description": "Write, inspect and publish SARIF 2.1.0 findings as one GitHub draft pull request review, with durable, never-duplicating delivery.",
  "keywords": [
    "sarif",
    "github",
    "code-review",
    "pull-request"
  ],
  "homepage": "https://github.com/mike-north/sarif-to-comment#readme",
  "bugs": {
    "url": "https://github.com/mike-north/sarif-to-comment/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/sarif-to-comment.git"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "types": "./dist/sarif-to-comment.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sarif-to-comment.d.ts",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sarif-to-comment": "dist/sarif-to-comment.cjs"
  },
  "files": [
    "dist/",
    "!dist/*.d.cts",
    "!dist/*.tsbuildinfo",
    "!dist/.build-inputs.json",
    "!dist/public-api.cjs",
    "!dist/public-types.cjs",
    "vendor/",
    "docs/getting-started.md",
    "docs/api/",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "check": "npm run check:lint && npm run check:types && npm run check:api && npm run check:release && npm test",
    "check:build": "node scripts/build-manifest.mts verify",
    "check:lint": "eslint .",
    "check:types": "node scripts/check-types.mts",
    "check:api": "node scripts/api-docs.mts check",
    "check:release": "node scripts/release-guard.mts plan",
    "test": "npm run check:build && node --test \"test/**/*.test.mts\"",
    "release:version": "node scripts/release-guard.mts version",
    "prepublishOnly": "node scripts/release-guard.mts check-version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-documenter": "^7.30.16",
    "@microsoft/api-extractor": "^7.59.2",
    "@types/node": "22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^6.0.1"
  }
}
