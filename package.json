{
  "name": "sarif-to-comment",
  "version": "0.1.0",
  "private": true,
  "description": "Publish a ready SARIF 2.1.0 document as one GitHub draft pull request review, with durable, never-duplicating delivery.",
  "keywords": [
    "sarif",
    "github",
    "code-review",
    "pull-request"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "main": "./src/index.cjs",
  "exports": {
    ".": "./src/index.cjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "sarif-to-comment": "./bin/sarif-to-comment.cjs"
  },
  "files": [
    "src/",
    "bin/",
    "vendor/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "check:lint": "eslint .",
    "check": "npm run check:lint && npm test"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1"
  }
}
