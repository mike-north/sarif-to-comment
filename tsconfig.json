{
  "//": "Type-checks the hand-authored public declarations (types/) and the in-repository declaration tests. Nothing is emitted; the runtime is CommonJS JavaScript in src/.",
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "noEmitOnError": true,
    "types": []
  },
  "files": ["types/index.d.ts"]
}
